{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Finanzas",
  "version": "1.0.0",
  "identifier": "mx.finanzas.escritorio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Finanzas",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#08090B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Finanzas",
    "shortDescription": "Tus gastos, apartados y metas",
    "longDescription": "Tus gastos de BBVA, Santander y Google Wallet, tus apartados y tus metas.",
    "category": "Finance",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
